<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if page_title %}{{ page_title }} · {% endif %}{{ shop.name }}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{{ content_for_header }}
{{ 'sarviums-v2.css' | asset_url | stylesheet_tag }}
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@400;500;600&display=swap');
:root{--paper:#f5f0e7;--ink:#171513;--gold:#b68a43;--muted:#756f66}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Montserrat,Arial,sans-serif}a{color:inherit;text-decoration:none}
.sv-top{background:#171513;color:#fff;text-align:center;padding:10px;font-size:10px;letter-spacing:3px}.sv-header{border-bottom:1px solid #ddd5c8;background:var(--paper)}.sv-nav{max-width:1280px;margin:auto;min-height:105px;display:flex;align-items:center;justify-content:space-between;padding:20px 32px;gap:25px}.sv-links{display:flex;gap:25px;font-size:10px;letter-spacing:2px;text-transform:uppercase}.sv-logo{text-align:center}.sv-mark{width:38px;height:38px;border:1px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:auto;font:500 25px Georgia,serif;color:var(--gold)}.sv-name{display:block;font:500 28px 'Cormorant Garamond',serif;letter-spacing:7px;margin-top:3px}.sv-tag{display:block;color:var(--gold);font-size:7px;letter-spacing:3px;margin-top:2px}
.sv-hero{min-height:610px;display:grid;grid-template-columns:1.25fr .75fr;background:#1a1816;color:#fff}.sv-hero-copy{padding:90px clamp(35px,8vw,130px);align-self:center}.sv-kicker{font-size:10px;letter-spacing:4px;color:var(--gold);text-transform:uppercase}.sv-hero h1{font:500 clamp(55px,7vw,100px)/.86 'Cormorant Garamond',serif;margin:25px 0}.sv-hero h1 em{color:#d0ad75}.sv-lead{max-width:510px;color:#c9c2b7;line-height:1.8;font-size:14px}.sv-button{display:inline-block;background:var(--gold);color:#fff;padding:16px 24px;margin-top:22px;font-size:10px;letter-spacing:2px}.sv-hero-mark{display:flex;align-items:center;justify-content:center;background:radial-gradient(circle,#806137 0,#28231d 42%,#1a1816 70%)}.sv-hero-mark span{width:230px;height:230px;border:1px solid #b68a43;border-radius:50%;display:flex;align-items:center;justify-content:center;font:400 170px 'Cormorant Garamond',serif;color:#b68a43}
.sv-intro{text-align:center;padding:100px 25px 55px}.sv-intro h2,.sv-story h2,.sv-newsletter h2{font:500 55px/1 'Cormorant Garamond',serif;margin:10px 0}.sv-intro>p:last-child{color:var(--muted)}
.sv-products{max-width:1280px;margin:auto;padding:25px 32px 100px;display:grid;grid-template-columns:repeat(4,1fr);gap:28px}.sv-card-image{aspect-ratio:3/4;background:#e9e1d5;overflow:hidden}.sv-card-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.sv-card:hover img{transform:scale(1.04)}.sv-card-info{display:flex;justify-content:space-between;gap:12px;padding-top:13px}.sv-card-info h3{font:500 19px 'Cormorant Garamond',serif;margin:0}.sv-card-info span{font-size:11px;white-space:nowrap}.sv-placeholder{height:100%;display:flex;align-items:center;justify-content:center;font:100px 'Cormorant Garamond',serif;color:var(--gold)}.sv-empty{grid-column:1/-1;text-align:center;padding:60px;color:var(--muted)}
.sv-story{background:#ebe3d7;display:grid;grid-template-columns:1fr 1fr;gap:70px;padding:110px max(32px,8vw);align-items:center}.sv-story>p{max-width:500px;line-height:2;color:#625b53}.sv-newsletter{text-align:center;padding:100px 25px}.sv-newsletter form{display:flex;max-width:520px;margin:30px auto 0;border-bottom:1px solid #777}.sv-newsletter input{flex:1;border:0;background:transparent;padding:15px;outline:0;font:12px Montserrat}.sv-newsletter button{border:0;background:transparent;padding:15px;letter-spacing:2px;font-size:10px}
.sv-footer{background:#171513;color:#ddd5c8;padding:65px 8vw 25px}.sv-footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:50px}.sv-footer h3{font:500 30px 'Cormorant Garamond',serif;color:#fff}.sv-footer h4{font-size:10px;letter-spacing:2px;color:#b68a43}.sv-footer a{display:block;margin:12px 0;font-size:11px}.sv-copy{border-top:1px solid #39342e;margin-top:45px;padding-top:20px;font-size:9px;letter-spacing:1px;color:#888}
@media(max-width:800px){.sv-nav{padding:18px}.sv-links{display:none}.sv-hero{grid-template-columns:1fr}.sv-hero-mark{min-height:300px}.sv-products{grid-template-columns:repeat(2,1fr);padding:20px;gap:18px}.sv-story{grid-template-columns:1fr;gap:20px;padding:70px 25px}.sv-footer-grid{grid-template-columns:1fr}.sv-intro h2,.sv-story h2,.sv-newsletter h2{font-size:43px}}
</style>
</head>
<body>
<div class="sv-top">BEYOND ORDINARY · COMPLIMENTARY SHIPPING ON ORDERS $75+</div>
<header class="sv-header"><nav class="sv-nav">
<div class="sv-links"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.collections_url }}">Shop All</a></div>
<a class="sv-logo" href="{{ routes.root_url }}"><span class="sv-mark">S</span><span class="sv-name">SARVIUMS</span><span class="sv-tag">BEYOND ORDINARY</span></a>
<div class="sv-links"><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div>
</nav></header>
<main>{{ content_for_layout }}</main>
<footer class="sv-footer"><div class="sv-footer-grid"><div><h3>SARVIUMS</h3><p>Beyond Ordinary — jewellery for moments worth remembering.</p></div><div><h4>SHOP</h4><a href="{{ routes.collections_url }}">All Jewellery</a><a href="/collections/necklaces">Necklaces</a><a href="/collections/earrings">Earrings</a></div><div><h4>HELP</h4><a href="/pages/contact">Contact</a><a href="/policies/shipping-policy">Shipping</a><a href="/policies/refund-policy">Returns</a></div></div><div class="sv-copy">© {{ 'now' | date: '%Y' }} SARVIUMS · Beyond Ordinary</div></footer>
</body>
</html>