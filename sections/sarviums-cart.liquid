<section class="section cart-page"><div class="section-heading"><p class="eyebrow">YOUR BAG</p><h1>Shopping Bag</h1></div>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row"><div class="cart-thumb">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}</div><div class="cart-info"><h3>{{ item.product.title }}</h3><p>{{ item.final_line_price | money }}</p><input name="updates[]" type="number" min="0" value="{{ item.quantity }}"></div></div>{% endfor %}<div class="cart-total">Total <strong>{{ cart.total_price | money }}</strong></div><div class="cart-actions"><button class="outline-button" name="update">Update bag</button><button class="gold-button" name="checkout">Checkout</button></div></form>{% else %}<p>Your bag is currently empty.</p><a class="gold-button" href="{{ routes.collections_url }}">Continue shopping</a>{% endif %}</section>