<section class="section"><div class="section-head"><p class="eyebrow">SEARCH</p><h1>Find your piece</h1></div><form action="{{ routes.search_url }}" method="get" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search jewellery"><button class="btn dark">Search</button></form>{% if search.performed %}<div class="products">{% for item in search.results %}{% if item.object_type=='product' %}<a class="card" href="{{ item.url }}"><div class="card-img">{% if item.featured_image %}{{ item.featured_image | image_url:width:800 | image_tag:loading:'lazy',alt:item.title }}{% endif %}</div><div class="card-meta"><h3>{{ item.title }}</h3><span>{{ item.price | money }}</span></div></a>{% endif %}{% endfor %}</div>{% endif %}</section>