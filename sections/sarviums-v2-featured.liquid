<section class="section"><div class="section-head split"><div><p class="eyebrow">THE SARVIUMS EDIT</p><h2>{{ section.settings.title }}</h2></div><a class="text-link" href="{{ routes.collections_url }}">View all →</a></div>{% assign col=collections[section.settings.collection] %}<div class="products">{% for product in col.products limit:section.settings.products_to_show %}<a class="card" href="{{ product.url }}"><div class="card-img">{% if product.featured_image %}{{ product.featured_image | image_url:width:900 | image_tag:loading:'lazy',alt:product.title }}{% endif %}<span class="quick">View</span></div><div class="card-meta"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div></a>{% endfor %}</div></section>{% schema %}{"name":"Product showcase","settings":[{"type":"text","id":"title","label":"Title","default":"Best Sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products","min":4,"max":8,"step":4,"default":8}]}{% endschema %}