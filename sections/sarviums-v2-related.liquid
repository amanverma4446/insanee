<section class="section"><div class="section-head"><p class="eyebrow">YOU MAY ALSO LOVE</p><h2>Complete the look</h2></div><div class="products">{% for product in collections.all.products limit:4 %}<a class="card" href="{{ product.url }}"><div class="card-img">{% if product.featured_image %}{{ product.featured_image | image_url:width:800 | image_tag:loading:'lazy',alt:product.title }}{% endif %}</div><div class="card-meta"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div></a>{% endfor %}</div></section>