<section class="product-v2"><div class="gallery">{% for image in product.images %}<div class="gallery-img">{{ image | image_url:width:1400 | image_tag:loading:'lazy',alt:product.title }}</div>{% endfor %}</div><div class="p-info"><p class="eyebrow">SARVIUMS</p><h1>{{ product.title }}</h1><div class="p-price">{{ product.price | money }}</div>{% if product.description != blank %}<div class="p-desc">{{ product.description }}</div>{% endif %}{% form 'product',product,class:'buy-form' %}{% unless product.has_only_default_variant %}<select name="id">{% for v in product.variants %}<option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>{{ v.title }} — {{ v.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<div class="qty"><label>Qty</label><input name="quantity" type="number" min="1" value="1"></div><button class="btn gold full" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}<div class="service-notes"><div>✦ Secure checkout</div><div>✦ Shipping calculated at checkout</div><div>✦ Customer support</div></div></div></section>