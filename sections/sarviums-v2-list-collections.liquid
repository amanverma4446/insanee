<section class="section shop-all-page">
  <div class="collection-hero">
    <p class="eyebrow">SARVIUMS</p>
    <h1>Shop All</h1>
    <p>Discover the complete SARVIUMS collection.</p>
  </div>

  {% assign categories = 'Necklaces|necklace;Earrings|earring;Bangles|bangle' | split: ';' %}
  {% for category in categories %}
    {% assign parts = category | split: '|' %}
    {% assign category_name = parts[0] %}
    {% assign keyword = parts[1] %}
    {% assign category_count = 0 %}
    {% for product in collections.all.products %}
      {% assign title = product.title | downcase %}
      {% if title contains keyword %}
        {% assign category_count = category_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if category_count > 0 %}
      <div class="shop-category">
        <div class="section-head split">
          <h2>{{ category_name }}</h2>
        </div>
        <div class="products">
          {% for product in collections.all.products %}
            {% assign title = product.title | downcase %}
            {% if title contains keyword %}
              <a class="card" href="{{ product.url }}">
                <div class="card-img">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
                  {% else %}
                    <div class="sv-placeholder">S</div>
                  {% endif %}
                </div>
                <div class="card-meta"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</section>