<section class="section"><div class="section-head center"><p class="eyebrow">SARVIUMS</p><h1>Shop All</h1></div><div class="style-grid">{% for collection in collections %}<a class="style-card" href="{{ collection.url }}"><div class="style-bg">{% if collection.featured_image %}{{ collection.featured_image | image_url:width:900 | image_tag:loading:'lazy',alt:collection.title }}{% else %}<span>{{ collection.title | slice:0 }}</span>{% endif %}</div><div><h3>{{ collection.title }}</h3><span class="arrow">Explore →</span></div></a>{% endfor %}</div></section>