<section class="section shop-all-page">
  <div class="collection-hero">
    <p class="eyebrow">SARVIUMS</p>
    <h1>Shop All</h1>
    <p>Discover the complete SARVIUMS collection.</p>
  </div>

  <div class="shop-filters" role="tablist" aria-label="Jewellery categories">
    <button class="shop-filter is-active" type="button" data-filter="all">All</button>
    <button class="shop-filter" type="button" data-filter="necklace">Necklaces</button>
    <button class="shop-filter" type="button" data-filter="earring">Earrings</button>
    <button class="shop-filter" type="button" data-filter="bangle">Bangles</button>
  </div>

  <div class="products shop-filter-grid" data-shop-grid>
    {% for product in collections.all.products %}
      {% assign title = product.title | downcase %}
      {% assign category = 'other' %}
      {% if title contains 'necklace' %}{% assign category = 'necklace' %}
      {% elsif title contains 'earring' %}{% assign category = 'earring' %}
      {% elsif title contains 'bangle' %}{% assign category = 'bangle' %}
      {% endif %}

      <a class="card shop-product" data-category="{{ category }}" href="{{ product.url }}">
        <div class="card-img">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
          {% else %}
            <div class="sv-placeholder">S</div>
          {% endif %}
        </div>
        <div class="card-meta">
          <h3>{{ product.title }}</h3>
          <span>{{ product.price | money }}</span>
        </div>
      </a>
    {% endfor %}
  </div>

  <p class="shop-empty" data-shop-empty hidden>No products found in this category.</p>
</section>

<script>
(function(){
  const root = document.querySelector('.shop-all-page');
  if (!root || root.dataset.filterReady) return;
  root.dataset.filterReady = 'true';

  const buttons = root.querySelectorAll('[data-filter]');
  const products = root.querySelectorAll('.shop-product');
  const empty = root.querySelector('[data-shop-empty]');

  function filter(category){
    let visible = 0;
    products.forEach(product => {
      const show = category === 'all' || product.dataset.category === category;
      product.hidden = !show;
      if(show) visible++;
    });
    buttons.forEach(button => {
      const active = button.dataset.filter === category;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    if(empty) empty.hidden = visible !== 0;
  }

  buttons.forEach(button => button.addEventListener('click', () => filter(button.dataset.filter)));
  filter('all');
})();
</script>