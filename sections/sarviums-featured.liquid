<section class="section"><div class="section-heading split"><div><p class="eyebrow">THE EDIT</p><h2>{{ section.settings.title }}</h2></div><a class="text-link" href="{{ routes.collections_url }}">View all →</a></div>{% assign selected = collections[section.settings.collection] %}<div class="product-grid">{% for product in selected.products limit: section.settings.products_to_show %}<a class="product-card" href="{{ product.url }}"><div class="product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_image.alt | escape }}{% else %}<div class="no-image">SARVIUMS</div>{% endif %}</div><div class="product-info"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div></a>{% else %}<p class="empty">Your imported products will appear here once the collection is available.</p>{% endfor %}</div></section>{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"title","label":"Title","default":"Curated Favourites"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products","min":4,"max":12,"step":4,"default":8}]}{% endschema %}