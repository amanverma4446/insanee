<section class="section collection-page"><div class="collection-hero"><p class="eyebrow">SARVIUMS</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}</div><div class="collection-toolbar"><span>{{ collection.products_count }} pieces</span></div><div class="products">{% paginate collection.products by 24 %}{% for product in collection.products %}<a class="card" href="{{ product.url }}"><div class="card-img">{% if product.featured_image %}{{ product.featured_image | image_url:width:900 | image_tag:loading:'lazy',alt:product.title }}{% endif %}</div><div class="card-meta"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div></a>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div></section>