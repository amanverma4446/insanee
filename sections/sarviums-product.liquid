<section class="product-page"><div class="product-media">{% for image in product.images %}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image.alt | escape }}{% endfor %}</div><div class="product-details"><p class="eyebrow">SARVIUMS</p><h1>{{ product.title }}</h1><div class="price">{{ product.price | money }}</div>{% if product.description != blank %}<div class="description">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="variant">Select option</label><select id="variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="qty">Quantity</label><input id="qty" name="quantity" type="number" min="1" value="1"><button class="gold-button full" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to Bag{% else %}Sold Out{% endif %}</button>{% endform %}</div></section>