<section class="section cart-page"><div class="section-head"><p class="eyebrow">YOUR BAG</p><h1>Shopping bag</h1></div>{% if cart.item_count>0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-item"><div class="cart-img">{{ item.image | image_url:width:300 | image_tag:loading:'lazy' }}</div><div><h3>{{ item.product.title }}</h3><p>{{ item.final_line_price | money }}</p><input name="updates[]" type="number" min="0" value="{{ item.quantity }}"></div></div>{% endfor %}<div class="cart-total"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div><div class="cart-actions"><button class="btn outline" name="update">Update</button><button class="btn gold" name="checkout">Checkout</button></div></form>{% else %}<div class="empty-cart"><h2>Your bag is waiting.</h2><a class="btn gold" href="{{ routes.collections_url }}">Continue shopping</a></div>{% endif %}</section>